generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  binaryTargets   = ["native", "debian-openssl-1.1.x", "rhel-openssl-1.1.x"]
  output          = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AvailedItemType {
  SERVICE
  SET
}

enum Role {
  OWNER
  CASHIER
  WORKER
  ATTENDANCE_CHECKER
  MASSEUSE
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum Status {
  PENDING
  DONE
  CANCELLED
}

enum PaymentMethod {
  ewallet
  cash
  bank
  GIFT_CERTIFICATE
}

enum PayslipStatus {
  PENDING
  RELEASED
}

enum FollowUpPolicy {
  NONE
  ONCE
  EVERY_TIME
}

enum PayslipRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum RecommendedAppointmentStatus {
  RECOMMENDED
  SCHEDULED
  ATTENDED
  CANCELLED
  MISSED
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  SUPPLIES
  MARKETING
  MAINTENANCE
  OTHER
}

// FILE: schema.prisma

model PayslipRequest {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation("AccountRequests", fields: [accountId], references: [id], onDelete: Cascade)
  requestTimestamp DateTime @default(now())

  // --- CORRECTED ---
  periodStartDate DateTime // @db.Date removed
  periodEndDate   DateTime // @db.Date removed

  status PayslipRequestStatus @default(PENDING)
  notes  String?

  processedById      String?
  processedBy        Account?  @relation("AdminManagedRequests", fields: [processedById], references: [id])
  processedTimestamp DateTime?

  relatedPayslipId String?  @unique
  relatedPayslip   Payslip? @relation(fields: [relatedPayslipId], references: [id])

  @@index([accountId, status])
  @@index([status])
}

model Payslip {
  id        String  @id @default(uuid())
  accountId String
  account   Account @relation("EmployeePayslips", fields: [accountId], references: [id])

  // --- CORRECTED ---
  periodStartDate DateTime // @db.Date removed
  periodEndDate   DateTime // @db.Date removed

  baseSalary       Int
  totalCommissions Int
  totalDeductions  Int           @default(0)
  totalBonuses     Int           @default(0)
  netPay           Int
  status           PayslipStatus @default(PENDING)
  releasedDate     DateTime?
  generatedAt      DateTime      @default(now())

  payslipRequest PayslipRequest?

  @@unique([accountId, periodStartDate, periodEndDate])
  @@index([accountId])
  @@index([periodStartDate, periodEndDate])
  @@index([status])
}

model RecommendedAppointment {
  id                       String       @id @default(uuid())
  customerId               String
  customer                 Customer     @relation(fields: [customerId], references: [id])
  recommendedDate          DateTime     @db.Date
  originatingTransactionId String?
  originatingTransaction   Transaction? @relation("OriginatingTransaction", fields: [originatingTransactionId], references: [id])

  // Update relation to point to the original AvailedService
  originatingAvailedServiceId String         @unique
  originatingAvailedService   AvailedService @relation("RecommendedByAvailedService", fields: [originatingAvailedServiceId], references: [id])

  originatingServiceId String
  originatingService   Service @relation("RecommendedServiceType", fields: [originatingServiceId], references: [id])

  status RecommendedAppointmentStatus @default(RECOMMENDED)

  attendedTransactionId String?      @unique
  attendedTransaction   Transaction? @relation("AttendedTransaction", fields: [attendedTransactionId], references: [id])

  suppressNextFollowUpGeneration Boolean @default(false)

  reminder3DaySentAt      DateTime?
  reminder2DaySentAt      DateTime?
  reminder1DaySentAt      DateTime?
  reminderTodaySentAt     DateTime?
  reminder1DayAfterSentAt DateTime?
  reminder7DaySentAt      DateTime?

  reminder7DayAfterSentAt  DateTime?
  reminder14DayAfterSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([recommendedDate])
  @@index([status])
  @@index([attendedTransactionId])
  @@index([originatingServiceId])
  @@index([suppressNextFollowUpGeneration])
}

model DiscountRule {
  id            String       @id @default(uuid())
  description   String?
  discountType  DiscountType
  discountValue Float
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)

  applyToAll Boolean   @default(false)
  services   Service[] @relation("DiscountedServices")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startDate, endDate])
}

model Branch {
  id         String    @id @default(uuid())
  title      String    @unique
  code       String    @unique @db.VarChar(6)
  totalSales Int       @default(0)
  services   Service[]
  accounts   Account[]

  manualSales ManualSale[]
  expenses    Expense[]

  Transaction Transaction[]
}

model Attendance {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  accountId   String
  account     Account  @relation("EmployeeAttendance", fields: [accountId], references: [id])
  isPresent   Boolean  @default(false)
  notes       String?
  checkedById String
  checkedBy   Account  @relation("CheckerAttendance", fields: [checkedById], references: [id])
  checkedAt   DateTime @default(now())

  @@unique([date, accountId])
  @@index([date])
}

model Account {
  id                 String               @id @default(uuid())
  username           String               @unique @db.VarChar(20)
  password           String
  name               String
  email              String?              @unique @db.VarChar(255)
  role               Role[]               @default([WORKER])
  salary             Int                  @default(0)
  dailyRate          Int                  @default(350)
  branchId           String?
  branch             Branch?              @relation(fields: [branchId], references: [id])
  unitsServed        AvailedServiceUnit[] @relation("ServedRelation")
  unitsChecked       AvailedServiceUnit[] @relation("CheckedRelation")
  attendances        Attendance[]         @relation("EmployeeAttendance")
  attendancesChecked Attendance[]         @relation("CheckerAttendance")
  canRequestPayslip  Boolean              @default(false)

  payslips Payslip[] @relation("EmployeePayslips")

  payslipRequests        PayslipRequest[] @relation("AccountRequests")
  managedPayslipRequests PayslipRequest[] @relation("AdminManagedRequests")

  manualSales ManualSale[] @relation("RecordedByAccountManualSales")
  expenses    Expense[]    @relation("RecordedByAccountExpenses")

  mustChangePassword Boolean @default(false)

  @@index([branchId])
}

model Service {
  id String @id @default(uuid())

  title            String            @unique
  description      String?
  price            Int               @default(0) // This is the base price for a *single unit*
  branchId         String
  totalSales       Int               @default(0)
  branch           Branch            @relation(fields: [branchId], references: [id])
  AvailedService   AvailedService[] // Still links to the aggregated service line item
  serviceSets      ServiceSet[]      @relation("ServiceToSet")
  giftCertificates GiftCertificate[] @relation("GCService")
  discountRules    DiscountRule[]    @relation("DiscountedServices")

  recommendFollowUp       Boolean @default(false)
  recommendedFollowUpDays Int?

  followUpPolicy FollowUpPolicy @default(NONE)

  recommendedAppointments RecommendedAppointment[] @relation("RecommendedServiceType")

  sendPostTreatmentEmail    Boolean @default(false)
  postTreatmentEmailSubject String?
  postTreatmentInstructions String? @db.Text

  @@index([branchId])
}

model ServiceSet {
  id    String @id @default(uuid())
  title String @unique
  price Int

  services         Service[]         @relation("ServiceToSet")
  giftCertificates GiftCertificate[] @relation("GCServiceSet")
  AvailedService   AvailedService[]
}

model Customer {
  id              String    @id @default(uuid())
  name            String    @db.VarChar(50)
  email           String?   @unique @db.VarChar(255)
  totalPaid       Float     @default(0)
  nextAppointment DateTime?

  recommendedAppointments RecommendedAppointment[]

  transactionHistory        Transaction[]
  purchasedGiftCertificates GiftCertificate[] @relation("PurchasedGiftCertificates")

  receivedGiftCertificates GiftCertificate[] @relation("ReceivedGiftCertificates")
  GiftCertificate          GiftCertificate[]
}

model Voucher {
  id          String        @id @default(uuid())
  code        String        @unique
  value       Int
  usedAt      DateTime?
  Transaction Transaction[]
}

model Transaction {
  id              String           @id @default(uuid())
  createdAt       DateTime         @default(now())
  updatedAt       DateTime?        @updatedAt
  bookedFor       DateTime?        @default(now())
  customerId      String
  customer        Customer         @relation(fields: [customerId], references: [id])
  availedServices AvailedService[] // This remains the aggregate line item
  voucherId       String?
  voucherUsed     Voucher?         @relation(fields: [voucherId], references: [id])
  discount        Int              @default(0)
  paymentMethod   PaymentMethod?
  grandTotal      Int // This should be the sum of (AvailedService.price * quantity) for all AvailedServices, minus discount, etc.
  status          Status           @default(PENDING) // This status should now be derived from the status of all AvailedServiceUnits within its AvailedServices
  branchId        String?
  branch          Branch?          @relation(fields: [branchId], references: [id])

  bookingReminderSentAt DateTime?

  giftCertificateId   String?
  giftCertificateUsed GiftCertificate? @relation(fields: [giftCertificateId], references: [id])

  originatingRecommendations RecommendedAppointment[] @relation("OriginatingTransaction")
  attendedAppointment        RecommendedAppointment?  @relation("AttendedTransaction")

  @@index([customerId])
  @@index([createdAt])
  @@index([status, bookedFor, bookingReminderSentAt])
  @@index([branchId])
}

model AvailedService {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  quantity        Int @default(1)
  price           Int // Total price for this line item (quantity * unit price)
  commissionValue Int @default(0) // Total commission for this line item (quantity * unit commission)

  originatingSetId    String?
  originatingSetTitle String?
  originatingSet      ServiceSet? @relation(fields: [originatingSetId], references: [id])

  // REMOVE these fields - status and responsible parties are now on the unit level
  // checkedById String?
  // checkedBy   Account? @relation("CheckedRelation", fields: [checkedById], references: [id])
  // servedById   String?
  // servedBy     Account? @relation("ServedRelation", fields: [servedById], references: [id])
  serviceSetId String? // Seems redundant if originatingSetId/Title exist? Consider removing unless it has a different purpose.

  // REMOVE these fields - status and completion time are now on the unit level
  // status      Status    @default(PENDING)
  // completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Add relation to the individual units
  units AvailedServiceUnit[]

  // Recommended Appointment now links to the parent AvailedService record
  recommendedAppointment RecommendedAppointment? @relation("RecommendedByAvailedService")

  postTreatmentEmailSentAt DateTime?

  @@index([serviceId])
  @@index([transactionId])
  // REMOVE these indexes if fields are removed
  // @@index([checkedById])
  // @@index([servedById])
  @@index([originatingSetId])
}

// NEW MODEL: Represents a single unit of an AvailedService line item
model AvailedServiceUnit {
  id String @id @default(uuid())

  availedServiceId String // Link back to the parent AvailedService
  availedService   AvailedService @relation(fields: [availedServiceId], references: [id], onDelete: Cascade) // Use CASCADE delete

  unitIndex Int // 0-based index of the unit within the parent (0 to quantity-1)

  status      Status    @default(PENDING) // Status for this specific unit
  completedAt DateTime? // Completion timestamp for this specific unit

  checkedById String? // Who checked this specific unit
  checkedBy   Account?  @relation("CheckedRelation", fields: [checkedById], references: [id])
  checkedAt   DateTime? // When this specific unit was checked

  servedById String? // Who served this specific unit
  servedBy   Account?  @relation("ServedRelation", fields: [servedById], references: [id])
  servedAt   DateTime? // When this specific unit was served

  // Derived unit values (can also be calculated on the fly, but storing might simplify queries)
  // Alternatively, always divide parent's total_price/total_commission by quantity in queries
  // Let's keep it simple and rely on calculation for now. If performance is an issue, add these later.
  // basePrice Int // Calculated as AvailedService.price / AvailedService.quantity
  // baseCommissionValue Int // Calculated as AvailedService.commissionValue / AvailedService.quantity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure uniqueness for each unit within its parent service
  @@unique([availedServiceId, unitIndex])
  // Indexes for querying by who checked/served units
  @@index([checkedById])
  @@index([servedById])
  @@index([status]) // Index for filtering units by status
  @@index([availedServiceId]) // Index for fetching all units for a parent service
}

model GiftCertificate {
  id        String    @id @default(uuid())
  code      String    @unique
  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  purchaserCustomerId String?
  purchaserCustomer   Customer? @relation("PurchasedGiftCertificates", fields: [purchaserCustomerId], references: [id])

  recipientName  String?
  recipientEmail String?

  recipientCustomerId String?
  recipientCustomer   Customer? @relation("ReceivedGiftCertificates", fields: [recipientCustomerId], references: [id])

  services    Service[]    @relation("GCService")
  serviceSets ServiceSet[] @relation("GCServiceSet")

  usedAt DateTime?

  transactions Transaction[]
  Customer     Customer?     @relation(fields: [customerId], references: [id]) // Seems redundant? Customer should be linked via Transaction if used in one. Or is this for GCs owned by a customer? Keep for now if its purpose isn't clear.
  customerId   String? // Seems redundant with recipientCustomerId? Or is this for the customer who *holds* the GC, regardless of recipient? Keep for now.

  @@index([purchaserCustomerId])
  @@index([recipientCustomerId])
  @@index([customerId]) // Add index for the customer who holds it
}

model ManualSale {
  id            String         @id @default(uuid())
  date          DateTime       @db.Date
  amount        Int
  paymentMethod PaymentMethod?
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  recordedById String
  recordedBy   Account @relation("RecordedByAccountManualSales", fields: [recordedById], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([date])
  @@index([recordedById])
  @@index([branchId])
}

model Expense {
  id          String          @id @default(uuid())
  date        DateTime        @db.Date
  amount      Int
  category    ExpenseCategory
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  recordedById String
  recordedBy   Account @relation("RecordedByAccountExpenses", fields: [recordedById], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([date])
  @@index([category])
  @@index([recordedById])
  @@index([branchId])
}

model EmailTemplate {
  id           String   @id @default(uuid())
  name         String   @unique
  subject      String
  body         String   @db.Text
  placeholders String[]
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
}
